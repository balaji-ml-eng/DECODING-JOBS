# Core API this script seeds into.
API_URL=http://localhost:8000

# Adzuna Jobs API — free tier signup at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional tuning: pages fetched per role query (20 results/page) and delay
# between requests, to stay within Adzuna's free-tier rate/daily call limits.
ADZUNA_PAGES=1
ADZUNA_REQUEST_DELAY_MS=300
